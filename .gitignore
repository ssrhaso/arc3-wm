# --- Project artifacts (sacred but not committed) ---
data/*
!data/human_baselines.json
!data/README.md
checkpoints/
# Ignore run outputs under results/ EXCEPT the small random-policy RHAE
# summary (a paper input). The descend-friendly results/*<...>/* form is
# required: a bare `results/` would block git from descending, making the
# negations below dead. The bulk per-episode eval_episodes.jsonl under
# results/random-eval/<game>-<arm>/ stays ignored.
results/*
!results/random-eval/
results/random-eval/*
# Keep every game's random-policy RHAE summary (a few KB each): these are the measured
# floor the paper's ignition claim rests on, and they were laptop-only until 2026-09-06.
# The bulk per-episode eval_episodes.jsonl under results/random-eval/<game>-<arm>/ stays
# ignored.
!results/random-eval/*/
results/random-eval/*/*
!results/random-eval/*/random_rhae_summary.json
~/logdir/
logdir/

# arc_agi local game cache + recordings
environment_files/
recordings/

